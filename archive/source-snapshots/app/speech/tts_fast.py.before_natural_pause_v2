from __future__ import annotations

import queue
import re
import threading
import time

import numpy as np
import sounddevice as sd


KOKORO_SAMPLE_RATE = 24000


def clean_for_speech(
    text: str,
):

    text = text or ""

    # Remove citações RAG.
    text = re.sub(
        r"\[Fonte\s+\d+\]",
        "",
        text,
        flags=re.IGNORECASE,
    )

    # Markdown.
    text = text.replace(
        "**",
        "",
    )

    text = text.replace(
        "__",
        "",
    )

    text = text.replace(
        "`",
        "",
    )

    # URLs enormes não devem ser faladas.
    text = re.sub(
        r"https?://\S+",
        "link",
        text,
    )

    # ========================================================
    # PONTUAÇÃO PARA TTS
    #
    # O texto no terminal continua intacto.
    # Apenas a versão falada recebe pontuação mais suave.
    # ========================================================

    # Dois-pontos e ponto-e-vírgula causam pausas
    # exageradas no Kokoro.
    text = re.sub(
        r"\s*[:;]\s*",
        ", ",
        text,
    )

    # Reticências costumam gerar silêncio longo.
    text = re.sub(
        r"\.{2,}",
        ",",
        text,
    )

    # Evita sequências como "!!!" e "???".
    text = re.sub(
        r"!{2,}",
        "!",
        text,
    )

    text = re.sub(
        r"\?{2,}",
        "?",
        text,
    )

    # Espaços.
    text = re.sub(
        r"\s+",
        " ",
        text,
    )

    return text.strip()


class FastTTS:

    def __init__(
        self,
        voice="pf_dora",
        speed=1.08,
    ):

        self.voice = voice
        self.speed = speed

        self.pipeline = None

        self.queue = queue.Queue()

        self.worker = threading.Thread(
            target=self._worker,
            daemon=True,
        )

        self.worker.start()

        self.load_lock = (
            threading.Lock()
        )

        self.first_audio_time = None


    def load(self):

        if self.pipeline is not None:
            return

        with self.load_lock:

            if self.pipeline is not None:
                return

            print()
            print(
                "🔊 Carregando Kokoro TTS..."
            )

            start = time.perf_counter()

            from kokoro import KPipeline

            self.pipeline = KPipeline(
                lang_code="p",
                repo_id="hexgrad/Kokoro-82M",
                device="cpu",
            )

            print(
                "✅ Kokoro pronto em "
                f"{time.perf_counter() - start:.3f}s"
            )


    def say(
        self,
        text,
    ):

        text = clean_for_speech(
            text
        )

        if not text:
            return

        self.queue.put(
            text
        )


    def _worker(self):

        while True:

            text = self.queue.get()

            try:

                self.load()

                generator = self.pipeline(
                    text,
                    voice=self.voice,
                    speed=self.speed,
                    split_pattern=r"\n+",
                )

                for item in generator:

                    # Kokoro normalmente retorna:
                    # graphemes, phonemes, audio
                    audio = item[-1]

                    audio = np.asarray(
                        audio,
                        dtype=np.float32,
                    )

                    if (
                        self.first_audio_time
                        is None
                    ):
                        self.first_audio_time = (
                            time.perf_counter()
                        )

                    sd.play(
                        audio,
                        samplerate=
                            KOKORO_SAMPLE_RATE,
                    )

                    sd.wait()

            except Exception as exc:

                print()
                print(
                    "⚠️ TTS:",
                    repr(exc),
                )

            finally:

                self.queue.task_done()


    def wait(
        self,
    ):

        self.queue.join()


class SentenceTTSBuffer:

    def __init__(
        self,
        engine: FastTTS,
    ):

        self.engine = engine
        self.buffer = ""


    def reset(
        self,
    ):

        self.buffer = ""


    def feed(
        self,
        token: str,
    ):

        self.buffer += (
            token
        )

        self._emit_sentences()


    def _emit_sentences(
        self,
    ):

        while True:

            # Frase completa.
            match = re.search(
                r"^(.+?[.!?])(?:\s+|$)",
                self.buffer,
                flags=re.DOTALL,
            )

            if match:

                sentence = (
                    match
                    .group(1)
                    .strip()
                )

                self.buffer = (
                    self.buffer[
                        match.end():
                    ]
                )

                if sentence:

                    self.engine.say(
                        sentence
                    )

                continue

            # Se o modelo escreve uma frase enorme
            # sem ponto, libera no último separador.
            if len(self.buffer) >= 180:

                positions = [
                    self.buffer.rfind(","),
                    self.buffer.rfind(";"),
                ]

                cut = max(
                    positions
                )

                if cut >= 80:

                    piece = (
                        self.buffer[
                            :cut + 1
                        ]
                        .strip()
                    )

                    self.buffer = (
                        self.buffer[
                            cut + 1:
                        ]
                    )

                    if piece:

                        self.engine.say(
                            piece
                        )

                    continue

            break


    def flush(
        self,
    ):

        remaining = (
            self.buffer
            .strip()
        )

        self.buffer = ""

        if remaining:

            self.engine.say(
                remaining
            )


    def flush_and_wait(
        self,
    ):

        self.flush()

        self.engine.wait()
