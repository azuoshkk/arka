def modo_txt():

    set_tts_enabled(False)

    print()
    print(
        "=" * 64
    )

    print(
        " ARKA — TXT"
    )

    print(
        "=" * 64
    )

    print(
        "Digite sua mensagem."
    )

    print()
    print(
        "Comandos:"
    )

    print(
        " /modo    voltar ao menu"
    )

    print(
        " /limpar  limpar contexto"
    )

    print(
        " /sair    encerrar"
    )

    while True:

        try:

            texto = input(
                "\nVocê> "
            ).strip()

        except (
            KeyboardInterrupt,
            EOFError,
        ):

            print()

            return "menu"

        if not texto:
            continue

        comando = (
            texto
            .lower()
            .strip()
        )

        if comando in (
            "/modo",
            "/voltar",
        ):

            return "menu"

        if comando in (
            "/sair",
            "/exit",
            "/quit",
        ):

            return "exit"

        if comando == "/limpar":

            reset_voice_context()

            history[:] = [
                history[0]
            ]

            print(
                "✅ Contexto limpo."
            )

            continue

        try:

            processar(
                texto
            )

        except Exception as erro:

            print()
            print(
                "❌ Erro:",
                repr(erro),
            )



def normalize_stt_terms(
    texto: str,
):
    """
    Corrige apenas confusões fonéticas muito prováveis
    do Whisper dentro do contexto técnico da Arka.

    Não é usado no modo TXT.
    """

    original = texto

    q = texto.lower()

    technical_context = any(
        term in q
        for term in (
            "wifi",
            "wi-fi",
            "senha",
            "ros2",
            "ros 2",
            "sdk",
            "engineai",
            "robo",
            "robô",
            "firmware",
            "dashboard",
            "gateway",
            "camera",
            "câmera",
            "motor",
        )
    )

    if technical_context:

        # T e D são facilmente confundidos no STT.
        # Corrige somente no contexto técnico.
        texto = re.sub(
            r"\b[dD][\s-]*800\b",
            "T800",
            texto,
        )

    if texto != original:

        print(
            "🔧 Normalização STT:",
            repr(original),
            "→",
            repr(texto),
        )

    return texto


# ============================================================
# STT
# ============================================================

SAMPLE_RATE = 16000
VAD_CHUNK = 512

VAD_THRESHOLD = float(
    os.getenv(
        "VAD_THRESHOLD",
        "0.55",
    )
)

SILENCE_TIME = float(
    os.getenv(
        "SILENCE_TIME",
        "0.65",
    )
)

MAX_RECORD_TIME = float(
    os.getenv(
        "MAX_RECORD_TIME",
        "15",
    )
)

WHISPER_MODEL = os.getenv(
    "WHISPER_MODEL",
    "small",
)

WHISPER_BEAM_SIZE = int(
    os.getenv(
        "WHISPER_BEAM_SIZE",
        "5",
    )
)


WHISPER_INITIAL_PROMPT = """
Conversa em português brasileiro.

Possíveis termos:
Arka,
Arcanjo,
T800,
EngineAI,
Wi-Fi,
ROS2,
ros2_bridge,
RC02,
SDK,
dashboard,
MuJoCo,
Odin2,
Face Follow,
Raspberry Pi.
"""


whisper = None
whisper_device = None
vad_model = None


def carregar_stt():

    global whisper
    global whisper_device
    global vad_model

    if (
        whisper is not None
        and vad_model is not None
    ):
        return

    print()
    print(
        "🎧 Carregando STT..."
    )

    import torch
    import ctranslate2

    from faster_whisper import (
        WhisperModel,
    )

    from silero_vad import (
        load_silero_vad,
    )

    quantidade_gpus = (
        ctranslate2
        .get_cuda_device_count()
    )

    if quantidade_gpus > 0:

        try:

            print(
                f"Whisper: {WHISPER_MODEL}"
                " | GPU NVIDIA"
            )

            whisper = WhisperModel(
                WHISPER_MODEL,
                device="cuda",
                compute_type="float16",
            )

            whisper_device = (
                "GPU NVIDIA"
            )

        except Exception as erro:

            print(
                "⚠️ GPU falhou:",
                erro,
            )

            whisper = None

    if whisper is None:

        print(
            f"Whisper: {WHISPER_MODEL}"
            " | CPU"
        )

        whisper = WhisperModel(
            WHISPER_MODEL,
            device="cpu",
            compute_type="int8",
        )

        whisper_device = "CPU"

    torch.set_num_threads(
        1
    )

    vad_model = load_silero_vad()

    print(
        f"✅ STT pronto "
        f"({whisper_device}, beam "
        f"{WHISPER_BEAM_SIZE})"
    )


def ouvir():

    import numpy as np
    import sounddevice as sd
    import torch

    inicio_fala = None
    ultima_voz = None

    pre_buffer = deque(
        maxlen=12
    )

    gravacao = []

    falando = False
    silencio_frames = 0
    frames_fala = 0

    limite_silencio = int(
        SILENCE_TIME
        * SAMPLE_RATE
        / VAD_CHUNK
    )

    limite_fala = int(
        MAX_RECORD_TIME
        * SAMPLE_RATE
        / VAD_CHUNK
    )

    if hasattr(
        vad_model,
        "reset_states",
    ):

        vad_model.reset_states()

    print()
    print(
        "🎤 Fale..."
    )

    with sd.InputStream(
        samplerate=SAMPLE_RATE,
        channels=1,
        dtype="float32",
        blocksize=VAD_CHUNK,
    ) as stream:

        while True:

            data, _ = stream.read(
                VAD_CHUNK
            )

            audio = (
                data[:, 0]
                .copy()
            )

            tensor = (
                torch
                .from_numpy(
                    audio
                )
            )

            probabilidade = (
                vad_model(
                    tensor,
                    SAMPLE_RATE,
                )
                .item()
            )

            momento = (
                time.perf_counter()
            )

            if not falando:

                pre_buffer.append(
                    audio
                )

                if (
                    probabilidade
                    >= VAD_THRESHOLD
                ):

                    falando = True

                    inicio_fala = momento
                    ultima_voz = momento

                    print(
                        "🟢 Fala detectada."
                    )

                    gravacao.extend(
                        pre_buffer
                    )

                    pre_buffer.clear()

            else:

                gravacao.append(
                    audio
                )

                frames_fala += 1

                if (
                    probabilidade
                    >= VAD_THRESHOLD
                ):

                    silencio_frames = 0
                    ultima_voz = momento

                else:

                    silencio_frames += 1

                if (
                    silencio_frames
                    >= limite_silencio
                ):

                    break

                if (
                    frames_fala
                    >= limite_fala
                ):

                    print(
                        "⚠️ Limite de fala atingido."
                    )

                    break

    if not gravacao:

        return (
            None,
            None,
        )

    audio_final = np.concatenate(
        gravacao
    ).astype(
        np.float32
    )

    if (
        inicio_fala is not None
        and ultima_voz is not None
    ):

        tempo_fala = (
            ultima_voz
            - inicio_fala
        )

    else:

        tempo_fala = 0.0

    metricas = {
        "tempo_fala_ativa":
            tempo_fala,

        "duracao_audio":
            len(audio_final)
            / SAMPLE_RATE,
    }

    return (
        audio_final,
        metricas,
    )


def transcrever(audio):

    segmentos, _ = (
        whisper.transcribe(
            audio,
            language="pt",
            beam_size=
                WHISPER_BEAM_SIZE,
            best_of=
                WHISPER_BEAM_SIZE,
            temperature=0,
            condition_on_previous_text=
                False,
            initial_prompt=
                WHISPER_INITIAL_PROMPT,
            without_timestamps=True,
            vad_filter=False,
        )
    )

    texto = "".join(
        segmento.text
        for segmento
        in segmentos
    ).strip()

    return texto


def modo_stt():

    set_tts_enabled(True)

    carregar_stt()

    ensure_tts()

    print()
    print(
        "=" * 64
    )

    print(
        " ARKA — STT"
    )

    print(
        "=" * 64
    )

    print(
        "Você fala pelo microfone."
    )

    print(
        "A resposta da Arka aparece "
        "SOMENTE em texto."
    )

    print()
    print(
        "CTRL+C volta ao menu."
    )

    while True:

        try:

            audio, metricas = ouvir()

            if audio is None:
                continue

            inicio = (
                time.perf_counter()
            )

            texto = transcrever(
                audio
            )

            texto = normalize_stt_terms(
                texto
            )

            tempo = (
                time.perf_counter()
                - inicio
            )

            print()
            print(
                "Você [STT]>",
                texto,
            )

            print(
                f"STT: {tempo:.3f}s "
                f"| {whisper_device}"
            )

            if not texto:
                continue

            sanity = (
                analyze_transcription(
                    texto,
                    metricas,
                )
            )

            if sanity[
                "suspicious"
            ]:

                print(
                    "⚠️ Transcrição descartada:",
                    sanity["reason"],
                )

                continue

            comando = (
                texto
                .lower()
                .strip()
            )

            if comando in (
                "voltar",
                "voltar ao menu",
                "trocar modo",
                "mudar modo",
            ):

                return "menu"

            if comando in (
                "sair",
                "encerrar",
                "fechar arka",
            ):

                return "exit"

            processar(
                texto
            )

        except KeyboardInterrupt:

            print()
            print(
                "↩️ Voltando ao menu..."
            )

            return "menu"

        except Exception as erro:

            print()
            print(
                "❌ Erro STT:",
                repr(erro),
            )


