def escolher_modo():

    print()
    print(
        "=" * 64
    )

    print(
        " ARKA"
    )

    print(
        "=" * 64
    )

    print(
        "[1] TXT  — digitar mensagem"
    )

    print(
        "[2] STT  — falar no microfone"
    )

    print(
        "[0] Sair"
    )

    while True:

        opcao = input(
            "\nEscolha: "
        ).strip().lower()

        if opcao in (
            "1",
            "txt",
            "texto",
        ):

            return "txt"

        if opcao in (
            "2",
            "stt",
            "voz",
            "microfone",
        ):

            return "stt"

        if opcao in (
            "0",
            "sair",
            "exit",
        ):

            return "exit"

        print(
            "Opção inválida."
        )


def main():

    parser = (
        argparse.ArgumentParser()
    )

    parser.add_argument(
        "--mode",
        choices=[
            "txt",
            "stt",
        ],
    )

    args = parser.parse_args()

    print()
    print(
        "🤖 Arka online."
    )

    print(
        "LLM:",
        CHAT_MODEL,
    )

    modo = args.mode

    while True:

        if modo is None:

            modo = escolher_modo()

        if modo == "exit":
            break

        if modo == "txt":

            resultado = modo_txt()

        elif modo == "stt":

            resultado = modo_stt()

        else:

            resultado = "menu"

        if resultado == "exit":
            break

        modo = None

    print()
    print(
        "👋 Arka encerrada."
    )


if __name__ == "__main__":
    main()
