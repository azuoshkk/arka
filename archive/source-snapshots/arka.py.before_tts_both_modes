# ============================================================
# TTS
# ============================================================

tts_engine = None
tts_buffer = None
tts_enabled = False


def set_tts_enabled(
    enabled: bool,
):

    global tts_enabled

    tts_enabled = enabled


def ensure_tts():

    global tts_engine
    global tts_buffer

    if tts_engine is None:

        tts_engine = FastTTS(
            voice=os.getenv(
                "ARKA_TTS_VOICE",
                "pf_dora",
            ),

            speed=float(
                os.getenv(
                    "ARKA_TTS_SPEED",
                    "1.08",
                )
            ),
        )

        tts_buffer = SentenceTTSBuffer(
            tts_engine
        )

        # Carrega já para a primeira resposta
        # não pagar custo de inicialização.
        tts_engine.load()


def tts_begin():

    if (
        not tts_enabled
        or tts_buffer is None
    ):
        return

    tts_buffer.reset()


def tts_feed(
    token,
):

    if (
        not tts_enabled
        or tts_buffer is None
    ):
        return

    tts_buffer.feed(
        token
    )


def tts_finish():

    if (
        not tts_enabled
        or tts_buffer is None
    ):
        return

    tts_buffer.flush_and_wait()


# ============================================================
# CHAT NORMAL
# ============================================================

def responder_chat(texto: str):

    tts_begin()

    mensagens = history + [
        {
            "role": "user",
            "content": texto,
        }
    ]

    resposta = []

    print()
    print(
        "Arka> ",
        end="",
        flush=True,
    )

    with requests.post(
        OLLAMA_URL,
        json={
            "model": CHAT_MODEL,
            "messages": mensagens,
            "stream": True,
            "think": False,
            "keep_alive": "30m",
            "options": {
                "temperature": 0.3,
                "num_predict": 500,
            },
        },
        stream=True,
        timeout=(5, 180),
    ) as response:

        if not response.ok:

            print()
            print(
                f"❌ Ollama HTTP {response.status_code}"
            )

            print(
                response.text
            )

            response.raise_for_status()

        for line in response.iter_lines():

            if not line:
                continue

            data = json.loads(
                line
            )

            token = (
                data
                .get("message", {})
                .get("content", "")
            )

            if not token:
                continue

            resposta.append(
                token
            )

            print(
                token,
                end="",
                flush=True,
            )

            tts_feed(
                token
            )

    print()

    resposta_final = "".join(
        resposta
    ).strip()

    history.append(
        {
            "role": "user",
            "content": texto,
        }
    )

    history.append(
        {
            "role": "assistant",
            "content": resposta_final,
        }
    )

    if len(history) > 17:

        history[:] = (
            [history[0]]
            + history[-16:]
        )

    tts_finish()

    return resposta_final


# ============================================================
# ROUTER
# ============================================================

def processar(texto: str):

    inicio_rota = (
        time.perf_counter()
    )

    plano = prepare_voice_route(
        texto,
        project=PROJECT,
    )

    tempo_rota = (
        time.perf_counter()
        - inicio_rota
    )

    rota = plano[
        "route"
    ]

    print()
    print(
        "─" * 64
    )

    print(
        f"Rota: {rota.upper()} | "
        f"{plano.get('reason')} | "
        f"{tempo_rota:.3f}s"
    )

    print(
        "─" * 64
    )

    # ========================================================
    # CHAT
    # ========================================================

    if rota == "chat":

        return responder_chat(
            texto
        )

    # ========================================================
    # EXPERT STREAMING
    # ========================================================

    print()
    print(
        "Arka [EXPERT]> ",
        end="",
        flush=True,
    )

    tts_begin()

    def mostrar_token(
        token,
    ):

        print(
            token,
            end="",
            flush=True,
        )

        tts_feed(
            token
        )

    resultado = answer_stream(
        question=
            plano["question"],

        project=
            PROJECT,

        on_token=
            mostrar_token,
    )

    print()

    # Espera terminar a fala antes de
    # reabrir o microfone, evitando que
    # a Arka escute a própria voz.
    tts_finish()

    resposta = (
        resultado.get(
            "answer",
            ""
        )
    )

    fontes = (
        resultado.get(
            "sources"
        )
        or []
    )

    metricas = (
        resultado.get(
            "metrics"
        )
        or {}
    )

    print()

    retrieval = metricas.get(
        "retrieval"
    )

    first_token = metricas.get(
        "first_token"
    )

    total = metricas.get(
        "total"
    )

    partes = []

    if retrieval is not None:

        partes.append(
            f"retrieval={retrieval:.3f}s"
        )

    if first_token is not None:

        partes.append(
            f"1º token={first_token:.3f}s"
        )

    if total is not None:

        partes.append(
            f"total={total:.3f}s"
        )

    if partes:

        print(
            "⏱️ Expert: "
            + " | ".join(
                partes
            )
        )

    if fontes:

        print()
        print(
            "Fontes:"
        )

        vistos = set()

        for fonte in fontes:

            nome = (
                fonte.get(
                    "source"
                )
                or fonte.get(
                    "path"
                )
                or "fonte desconhecida"
            )

            if nome in vistos:
                continue

            vistos.add(
                nome
            )

            print(
                " -",
                nome,
            )

    # Histórico do chat normal.

    history.append(
        {
            "role":
                "user",

            "content":
                texto,
        }
    )

    history.append(
        {
            "role":
                "assistant",

            "content":
                resposta,
        }
    )

    if len(history) > 17:

        history[:] = (
            [history[0]]
            + history[-16:]
        )

    return resposta


